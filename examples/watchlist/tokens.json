{
  "breakpoints": {
    "sm": "40rem",
    "md": "48rem"
  },
  "scales": {
    "color": {
      "ink": "#14161f",
      "muted": "#5d6274",
      "line": "#e4e6ee",
      "bg": "#f6f7fb",
      "surface": "#ffffff",
      "accent": "#2f5bea",
      "accent-ink": "#ffffff",
      "up": "#0b7a53",
      "down": "#c2410c",
      "tint": "#eef2ff"
    },
    "space": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "8": "48px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "14px",
      "pill": "999px"
    },
    "font-size": {
      "sm": "13px",
      "md": "15px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px"
    },
    "shadow": {
      "sm": "0 1px 2px rgb(20 22 31 / 0.06)",
      "md": "0 1px 3px rgb(20 22 31 / 0.08), 0 8px 24px rgb(20 22 31 / 0.06)"
    }
  },
  "themes": {
    "[data-theme=\"dark\"]": {
      "@media": {
        "(prefers-color-scheme: dark)": ":root:not([data-theme=\"light\"])"
      },
      "color": {
        "ink": "#e9ebf3",
        "muted": "#9aa0b4",
        "line": "#2a2e3b",
        "bg": "#0f1117",
        "surface": "#171a23",
        "accent": "#7a9bff",
        "accent-ink": "#0f1117",
        "up": "#3ccf91",
        "down": "#ff8a5c",
        "tint": "#1d2333"
      }
    }
  },
  "utilities": {
    "display": {
      "property": "display",
      "values": {
        "block": "block",
        "flex": "flex",
        "grid": "grid",
        "none": "none"
      }
    },
    "direction": {
      "property": "flex-direction",
      "values": {
        "row": "row",
        "column": "column"
      }
    },
    "items": {
      "property": "align-items",
      "values": {
        "start": "start",
        "center": "center",
        "baseline": "baseline",
        "stretch": "stretch"
      }
    },
    "justify": {
      "property": "justify-content",
      "values": {
        "start": "start",
        "between": "space-between",
        "end": "end"
      }
    },
    "flex": {
      "property": "flex-wrap",
      "values": {
        "wrap": "wrap",
        "nowrap": "nowrap"
      }
    },
    "columns": {
      "property": "grid-template-columns",
      "values": {
        "1": "minmax(0, 1fr)",
        "2": "repeat(2, minmax(0, 1fr))",
        "main": "minmax(0, 2fr) minmax(0, 1fr)",
        "side": "minmax(12rem, 1fr) minmax(0, 3fr)"
      }
    },
    "gap": {
      "property": "gap",
      "scale": "space"
    },
    "p": {
      "property": "padding",
      "scale": "space"
    },
    "px": {
      "property": "padding-inline",
      "scale": "space"
    },
    "py": {
      "property": "padding-block",
      "scale": "space"
    },
    "m": {
      "property": "margin",
      "scale": "space"
    },
    "mb": {
      "property": "margin-block-end",
      "scale": "space"
    },
    "mx": {
      "property": "margin-inline",
      "values": {
        "0": "0",
        "auto": "auto"
      }
    },
    "max-w": {
      "property": "max-width",
      "values": {
        "page": "64rem",
        "prose": "40rem"
      }
    },
    "w": {
      "property": "width",
      "values": {
        "full": "100%",
        "auto": "auto"
      }
    },
    "text": {
      "property": "font-size",
      "scale": "font-size"
    },
    "weight": {
      "property": "font-weight",
      "values": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "fg": {
      "property": "color",
      "scale": "color"
    },
    "bg": {
      "property": "background-color",
      "scale": "color"
    },
    "border": {
      "property": "border",
      "values": {
        "line": "1px solid var(--color-line)",
        "none": "0"
      }
    },
    "rounded": {
      "property": "border-radius",
      "scale": "radius"
    },
    "shadow": {
      "property": "box-shadow",
      "scale": "shadow"
    },
    "align": {
      "property": "text-align",
      "values": {
        "start": "start",
        "end": "end"
      }
    },
    "numeric": {
      "property": "font-variant-numeric",
      "values": {
        "tabular": "tabular-nums"
      }
    },
    "tracking": {
      "property": "letter-spacing",
      "values": {
        "tight": "-0.02em",
        "wide": "0.04em"
      }
    },
    "upper": {
      "property": "text-transform",
      "values": {
        "yes": "uppercase"
      }
    },
    "leading": {
      "property": "line-height",
      "values": {
        "tight": "1.2",
        "normal": "1.5"
      }
    },
    "border-b": {
      "property": "border-block-end",
      "values": {
        "line": "1px solid var(--color-line)"
      }
    }
  }
}
