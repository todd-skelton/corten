{
  "breakpoints": {
    "sm": "40rem",
    "md": "48rem",
    "lg": "64rem"
  },
  "scales": {
    "color": {
      "ink": "#1d1b26",
      "muted": "#5f5b6b",
      "line": "#e3e0ea",
      "accent": "#6b3fd4",
      "bg": "#fbfaf7",
      "surface": "#fff",
      "danger": "#b42318",
      "tint": "#f1ecfd"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px"
    },
    "radius": {
      "sm": "8px",
      "md": "12px",
      "pill": "999px"
    },
    "font-size": {
      "sm": "13px",
      "md": "14px",
      "lg": "15px",
      "xl": "20px"
    },
    "shadow": {
      "sm": "0 1px 2px rgb(29 27 38 / 0.05)"
    }
  },
  "themes": {
    "[data-theme=\"dark\"]": {
      "@media": {
        "(prefers-color-scheme: dark)": ":root:not([data-theme=\"light\"])"
      },
      "color": {
        "ink": "#ecebf2",
        "muted": "#a9a5b8",
        "line": "#34313f",
        "bg": "#15141b",
        "surface": "#1e1c26",
        "tint": "#2a2340"
      }
    },
    "[data-density=\"compact\"]": {
      "space": {
        "3": "8px",
        "4": "12px",
        "5": "16px"
      }
    }
  },
  "utilities": {
    "gap": {
      "property": "gap",
      "scale": "space"
    },
    "direction": {
      "property": "flex-direction",
      "values": {
        "row": "row",
        "column": "column"
      }
    }
  }
}
