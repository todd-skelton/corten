          "type": "invalid",
          "module": "ui.combo_box",
          "name": "invalid",
          "args": [
            {
              "kind": "$e",
              "owner": null
            },
            {
              "kind": "$c",
              "owner": null
            }
          ]
        }
      ],
      "from": "corten-ui"
    },
    {
      "name": "a message for the handler to fill in",
      "attr": "connect:shared.say(@out,%[\"\",\"count\",\" listings\"])",
      "parsed": [
        {
          "type": "connect",
          "module": "shared",
          "name": "say",
          "args": [
            {
              "kind": "@",
              "owner": null,
              "name": "out"
            },
            {
              "kind": "%",
