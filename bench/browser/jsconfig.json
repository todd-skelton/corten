{
  "//": "Type-checks the view app against the declarations gen/ writes from the Rust Row (node build.mjs first): npx tsc -p bench/browser/jsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "paths": { "corten/state": ["../../crates/corten/js/state.js"], "corten/view": ["../../crates/corten/js/view.js"] }
  },
  "include": ["apps/view/*.js", "apps/shared/labels.js", "../../crates/corten/js/views.d.ts", "out/_gen/view/views.d.ts"]
}
